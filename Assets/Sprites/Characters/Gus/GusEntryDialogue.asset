  npcName: Gus
  npcPortrait: {fileID: 21300000, guid: 23544eabaaeda47f7829ce3ad3b6635c, type: 3}
  dialogueLines:
  - AH! REGGIE I CAN EXPLAIN PLEASE DON'T FIRE ME! I WAS SO HUNGRY AND THE CHEESE
    SMELLED SO GOOD I COULDN'T RESIST...
  - Wait who the hell are you?!
  - AH!
  - A misunderstanding....?
  - ...alright. We'll call it even. I can't risk another strike with Reggie, we're
    already on bad terms.
  - I'm stepping out for a few minutes. You better be gone before I get back or I'll
    call the cops.
  - ...alright. We'll call it even. I can't risk another strike with Reggie, we're
    already on bad terms.
  - I'm stepping out for a few minutes. Raid the fridge in that time and get lost
    or I'll call the cops.
  endDialogueLines: 0000010000010001
